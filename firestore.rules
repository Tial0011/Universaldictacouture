rules_version = '2';

// Starting point for the Phase 3/4 public catalogue. Review before
// deploying, and extend as later phases add orders and chats.
service cloud.firestore {
  match /databases/{database}/documents {

    // Public catalogue: published documents only, never writable from
    // the client.
    match /products/{productId} {
      allow read: if resource.data.status == 'published';
      allow write: if false;
    }

    match /heroSlides/{slideId} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }

    match /discoveryModules/{moduleId} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }

    // Style Circle: write-only. Reads are denied, so subscriber
    // addresses never leave the backend; a repeat signup is rejected
    // here, which is what the UI reports as a duplicate.
    match /styleCircleSubscribers/{key} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 320;
      allow read, update, delete: if false;
    }

    // Saved Pieces belong to the signed-in visitor alone.
    match /savedPieces/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
