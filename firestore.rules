rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // OWNER-AUTHORIZED ACTIVE-DEVELOPMENT COMPATIBILITY ONLY.
    // Remove with the JS adapter after every existing admin is canonically migrated.
    // Canonical/partial records never receive legacy fallback grants.
    function legacyDevelopmentMembership(staff) {
      return staff.get('active', false) == true && !staff.keys().hasAny(['staffId', 'capabilities']);
    }
    function legacyDevelopmentCapability(capability, purpose) {
      return (purpose == 'catalogue' && capability in ['products.read', 'products.create', 'products.edit', 'products.commercial', 'products.media', 'products.discovery', 'products.unpublish', 'products.archive', 'products.restore'])
        || (purpose == 'content' && capability in ['content.read', 'content.edit', 'content.delete'])
        || (purpose == 'customer-service' && capability in ['chats.read', 'chats.reply'])
        || (purpose == 'moderation' && capability == 'reviews.read')
        || (purpose == 'public-media' && capability == 'media.upload')
        || (purpose == 'audit' && capability == 'audit.read')
        || (purpose == 'operation-result' && capability == 'operations.reconcile')
        || (purpose == 'customer-support' && capability == 'customers.read')
        || (purpose == 'order-operations' && capability == 'orders.read')
        || (purpose == 'payment-operations' && capability == 'payments.read')
        || (purpose == 'custom-style' && capability == 'customStyle.read');
    }
    function effectiveStaffId() {
      let staff = get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
      return legacyDevelopmentMembership(staff) ? 'legacy-dev:' + request.auth.uid : staff.get('staffId', '');
    }
    // Provider binding lives at the existing membership path; staffId is durable
    // UDC identity. Role labels never grant data or business authority.
    function isStaff() {
      let staff = request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data : {};
      return request.auth != null
        && (!exists(/databases/$(database)/documents/principalSecurity/$(request.auth.uid))
          || request.auth.token.auth_time > get(/databases/$(database)/documents/principalSecurity/$(request.auth.uid)).data.validAfter)
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && staff.get('sharedAccount', false) != true && staff.get('active', false) == true
        && (legacyDevelopmentMembership(staff) || (staff.get('staffId', '') is string && staff.get('staffId', '').trim().size() > 0))
        && registryCompatible(staff);
    }
    function registryCompatible(staff) {
      let id = staff.get('staffId', '');
      // Existing reviewed memberships retain the development inheritance bridge.
      // Once provisioned, a mismatched/offboarded registry cannot be bypassed.
      return legacyDevelopmentMembership(staff)
        || !exists(/databases/$(database)/documents/staffIdentities/$(id))
        || (get(/databases/$(database)/documents/staffIdentities/$(id)).data.active == true
          && get(/databases/$(database)/documents/staffIdentities/$(id)).data.principalUid == request.auth.uid);
    }
    function validRoute(route, purpose) {
      return route.get('active', false) == true && route.get('purpose', '') == purpose;
    }
    function canStaff(capability, purpose, objectId, assignedStaffId) {
      let staff = request.auth != null
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data : {};
      let grant = staff.get('capabilities', {}).get(capability, {});
      let broad = grant.get('domainWide', {});
      let selected = grant.get('selectedObject', {});
      let assigned = grant.get('assignmentDerived', {});
      return isStaff() && (
        (legacyDevelopmentMembership(staff) && legacyDevelopmentCapability(capability, purpose))
        || validRoute(broad, purpose)
        || (validRoute(selected, purpose) && objectId in selected.get('ids', []))
        || (validRoute(assigned, purpose) && staff.get('functionAsCouturier', false) == true && staff.get('eligible', false) == true
          && assignedStaffId != '' && assignedStaffId == effectiveStaffId()));
    }
    function validAudit(targetCollection, targetId) {
      let id = request.resource.data.get('_lastOperationId', '');
      let path = /databases/$(database)/documents/staffAudit/$(id);
      let audit = getAfter(path).data;
      return id != '' && !exists(path)
        && audit.actorUid == request.auth.uid
        && audit.actorStaffId == effectiveStaffId()
        && audit.targetCollection == targetCollection && audit.targetId == targetId
        && audit.createdAt == request.time && audit.outcome == 'committed';
    }
    match /staffAudit/{eventId} {
      function validReplyEvidence() {
        let data = request.resource.data;
        let path = /databases/$(database)/documents/conversations/$(data.targetId)/messages/$(eventId);
        let message = getAfter(path).data;
        return data.targetCollection == 'conversations' && data.action == 'reply'
          && !exists(path)
          && message.senderId == request.auth.uid && message.senderRole == 'admin' && message.createdAt == request.time;
      }
      allow get: if isStaff() && ((resource.data.actorUid == request.auth.uid
        && resource.data.actorStaffId == effectiveStaffId()
        && canStaff('operations.reconcile', 'operation-result', eventId, '')) || canStaff('audit.read', 'audit', eventId, ''));
      allow list: if canStaff('audit.read', 'audit', eventId, '') && request.query.limit <= 20;
      allow create: if isStaff()
        && (canStaff('operations.reconcile', 'operation-result', eventId, '') || canStaff('audit.read', 'audit', eventId, ''))
        && request.resource.data.keys().hasOnly(['actorUid', 'actorStaffId', 'execution', 'targetCollection', 'targetId', 'action', 'outcome', 'createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorStaffId == effectiveStaffId()
        && request.resource.data.execution == 'staff'
        && request.resource.data.outcome == 'committed'
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.targetCollection in ['products', 'heroSlides', 'discoveryModules', 'taxonomy']
          && request.resource.data.action in ['save', 'unpublish', 'archive', 'restore']
          && getAfter(/databases/$(database)/documents/$(request.resource.data.targetCollection)/$(request.resource.data.targetId)).data._lastOperationId == eventId
          && getAfter(/databases/$(database)/documents/$(request.resource.data.targetCollection)/$(request.resource.data.targetId)).data.updatedAt == request.time)
          || validReplyEvidence());
      allow update, delete: if false;
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    // M01/M02 trusted server-owned control/evidence. The Admin SDK bypasses
    // these Rules; every Account API action performs current authorization.
    // Never grant ordinary clients direct control-plane reads/writes.
    match /accounts/{id} { allow read, write: if false; }
    match /accountBindings/{id} { allow read, write: if false; }
    match /accountLoginClaims/{id} { allow read, write: if false; }
    match /accountRegistrations/{id} { allow read, write: if false; }
    match /accountOperations/{id} { allow read, write: if false; }
    match /accountPreferences/{id} { allow read, write: if false; }
    match /accountAddressBooks/{id}/{nested=**} { allow read, write: if false; }
    match /accountAddressBooks/{id} { allow read, write: if false; }
    match /accountTombstones/{id} { allow read, write: if false; }
    match /accountProofs/{id} { allow read, write: if false; }
    match /accountProofOperations/{id} { allow read, write: if false; }
    match /accountRecoveryIntents/{id} { allow read, write: if false; }
    match /accountRecoveryIntake/{id} { allow read, write: if false; }
    match /accountEvidence/{id} { allow read, write: if false; }
    match /accountConsentEvidence/{id} { allow read, write: if false; }
    match /accountSecurityEvidence/{id} { allow read, write: if false; }
    match /accountLifecycleEvents/{id} { allow read, write: if false; }
    match /accountLifecycleProjection/{id} { allow read, write: if false; }
    match /accountRateLimits/{id} { allow read, write: if false; }
    match /accountSessions/{id} { allow read, write: if false; }
    match /accountSessionAdmission/{id} { allow read, write: if false; }
    match /sessionAccess/{id} {
      allow get: if request.auth != null && resource.data.uid == request.auth.uid;
      allow list, write: if false;
    }
    match /identityConflicts/{id} { allow read, write: if false; }
    match /identityLinkage/{id} { allow read, write: if false; }
    match /identityAudit/{id} { allow read, write: if false; }
    match /identityMigrationEvidence/{id} { allow read, write: if false; }
    match /staffHumanBindings/{id} { allow read, write: if false; }
    match /staffIdentities/{id} {
      // Own minimal identity/access record supports principal resolution, not
      // capability mutation or discovery of other humans. No secrets stored here.
      allow get: if request.auth != null && resource.data.principalUid == request.auth.uid
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('staffId', '') == id;
      allow list, write: if false;
    }
    match /principalSecurity/{id} { allow read, write: if false; }
    match /customerAccess/{uid} {
      // Minimal denial/revalidation signal only. This projection grants no
      // private-object authority; Account API always re-reads the owner/binding.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /products/{productId} {
      function productCapability(grants, capability) {
        let grant = grants.get(capability, {});
        let broad = grant.get('domainWide', {});
        let selected = grant.get('selectedObject', {});
        let membership = get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
        return (legacyDevelopmentMembership(membership) && legacyDevelopmentCapability(capability, 'catalogue'))
          || validRoute(broad, 'catalogue') || (validRoute(selected, 'catalogue') && productId in selected.get('ids', []));
      }
      function productFieldsAuthorized(grants) {
        let current = request.method == 'create' ? {} : resource.data;
        let next = request.resource.data;
        let descriptive = next.get('name', '') != current.get('name', '') || next.get('description', '') != current.get('description', '')
          || next.get('slug', '') != current.get('slug', '') || next.get('aliases', []) != current.get('aliases', [])
          || next.get('keywords', []) != current.get('keywords', []);
        let commercial = next.get('price', null) != current.get('price', null)
          || next.get('mainPrice', next.get('price', null)) != current.get('mainPrice', current.get('price', null))
          || next.get('unitLabel', next.get('priceToken', '')) != current.get('unitLabel', current.get('priceToken', ''))
          || next.get('priceToken', next.get('unitLabel', '')) != current.get('priceToken', current.get('unitLabel', ''))
          || next.get('variants', []) != current.get('variants', [])
          || next.diff(current).affectedKeys().hasAny(['options', 'serviceModes']);
        let media = next.get('images', []) != current.get('images', []) || next.get('primaryImage', null) != current.get('primaryImage', null);
        let discovery = next.get('category', []) != current.get('category', []) || next.get('occasion', []) != current.get('occasion', [])
          || next.get('style', []) != current.get('style', []) || next.get('fabric', []) != current.get('fabric', [])
          || next.get('colour', []) != current.get('colour', []) || next.get('shopBy', {}) != current.get('shopBy', {})
          || next.get('isNewIn', false) != current.get('isNewIn', false) || next.get('newIn', false) != current.get('newIn', false);
        return next.diff(current).affectedKeys().hasOnly(['name', 'description', 'slug', 'aliases', 'keywords', 'price', 'mainPrice', 'unitLabel', 'priceToken', 'variants', 'options', 'serviceModes', 'images', 'primaryImage', 'category', 'occasion', 'style', 'fabric', 'colour', 'shopBy', 'isNewIn', 'newIn', 'status', 'archived', 'publishedAt', 'firstPublishedAt', 'createdAt', 'updatedAt', '_version', '_lastOperationId'])
          && (!descriptive || productCapability(grants, request.method == 'create' ? 'products.create' : 'products.edit'))
          && (!commercial || productCapability(grants, 'products.commercial'))
          && (!media || productCapability(grants, 'products.media'))
          && (!discovery || productCapability(grants, 'products.discovery'));
      }
      function productTransitionAuthorized(grants) {
        let old = request.method == 'create' ? 'new' : resource.data.status;
        let next = request.resource.data.status;
        let audit = getAfter(/databases/$(database)/documents/staffAudit/$(request.resource.data._lastOperationId)).data;
        return (old == 'new' && next == 'draft' && audit.action == 'save' && productCapability(grants, 'products.create'))
          || (old == next && next != 'published' && audit.action == 'save'
            && (productCapability(grants, 'products.edit') || productCapability(grants, 'products.commercial') || productCapability(grants, 'products.media') || productCapability(grants, 'products.discovery')))
          || (old == 'published' && next == 'unpublished' && audit.action == 'unpublish' && productCapability(grants, 'products.unpublish'))
          || (old in ['draft', 'published', 'unpublished'] && next == 'archived' && audit.action == 'archive' && productCapability(grants, 'products.archive'))
          || (old == 'archived' && next == 'unpublished' && audit.action == 'restore' && productCapability(grants, 'products.restore'));
      }
      function productWriteAuthorized() {
        let grants = get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('capabilities', {});
        return productFieldsAuthorized(grants) && productTransitionAuthorized(grants);
      }
      function hasPublicProductImage(data) {
        return (data.keys().hasAny(['primaryImage'])
            && ((data.primaryImage is string && data.primaryImage.size() > 0)
              || data.primaryImage is map))
          || (data.keys().hasAny(['images'])
            && data.images is list
            && data.images.size() > 0);
      }
      allow read: if resource.data.status == 'published' || canStaff('products.read', 'catalogue', productId, '');
      allow create, update: if isStaff() && productWriteAuthorized()
        && validAudit('products', productId)
        && request.resource.data._version is int
        && request.resource.data._version == (request.method == 'create' ? 1 : resource.data.get('_version', 0) + 1)
        && (request.method == 'create' ? request.resource.data.get('publishedAt', null) == null
          : request.resource.data.get('publishedAt', null) == resource.data.get('publishedAt', null))
        && (request.method == 'create' ? request.resource.data.get('firstPublishedAt', null) == null : request.resource.data.get('firstPublishedAt', null) == resource.data.get('firstPublishedAt', null))
        && (request.method == 'create' ? request.resource.data.createdAt == request.time : request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.status in ['draft', 'published', 'unpublished', 'archived']
        && request.resource.data.archived is bool
        && request.resource.data.archived == (request.resource.data.status == 'archived')
        && (request.resource.data.status != 'published'
          || (request.resource.data.price is number
            && request.resource.data.price >= 0
            && request.resource.data.category is list
            && request.resource.data.category.size() > 0
            && ((request.resource.data.keys().hasAny(['unitLabel'])
                && request.resource.data.unitLabel is string
                && request.resource.data.unitLabel.size() > 0)
              || (request.resource.data.keys().hasAny(['priceToken'])
                && request.resource.data.priceToken is string
                && request.resource.data.priceToken.size() > 0))
            && hasPublicProductImage(request.resource.data)));
      // Historical-reference eligibility is not yet implemented by the Product
      // owner; deny destructive deletion until that owner guarantee exists.
      allow delete: if false;
    }
    match /heroSlides/{slideId} {
      allow read: if resource.data.published == true || canStaff('content.read', 'content', slideId, '');
      allow create, update: if canStaff('content.edit', 'content', slideId, '')
        && request.resource.data.published is bool
        && request.resource.data.headline is string
        && request.resource.data.headline.size() > 0
        && request.resource.data.concept in ['ready-to-wear', 'aso-oke-fabric', 'custom-style', 'shop-by-occasion', 'bridal-event-dressing'];
      allow delete: if canStaff('content.delete', 'content', slideId, '');
    }
    match /siteAppearance/{slotId} {
      allow read: if slotId == 'auth' || canStaff('content.read', 'content', slotId, '');
      allow create, update: if canStaff('content.edit', 'content', slotId, '')
        && slotId == 'auth'
        && request.resource.data.eyebrow is string
        && request.resource.data.eyebrow.size() > 0
        && request.resource.data.eyebrow.size() <= 80
        && request.resource.data.headline is string
        && request.resource.data.headline.size() > 0
        && request.resource.data.headline.size() <= 120
        && request.resource.data.supportingText is string
        && request.resource.data.supportingText.size() > 0
        && request.resource.data.supportingText.size() <= 260;
      allow delete: if canStaff('content.delete', 'content', slotId, '');
    }
    match /discoveryModules/{moduleId} {
      allow read: if resource.data.active == true || canStaff('content.read', 'content', moduleId, '');
      allow create, update: if canStaff('content.edit', 'content', moduleId, '')
        && request.resource.data.active is bool
        && request.resource.data.placement in ['home', 'shop']
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 12;
      allow delete: if false;
    }
    match /reviews/{reviewId} {
      allow read: if resource.data.published == true || canStaff('reviews.read', 'moderation', reviewId, '');
      // Consent/version/eligibility owner contract is not implemented in the
      // legacy writer. No general Admin permission substitutes for it.
      allow create, update: if false;
      allow delete: if false;
    }
    match /taxonomy/{labelId} {
      // Labels drive the public Shop filters, so every visitor can read
      // them. Writes stay admin-only. Public filters merge these labels
      // with counts from published products, so an admin allocation
      // appears even before a product uses it (with a zero count).
      allow read: if true;
      allow create, update: if canStaff('content.edit', 'content', labelId, '')
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.dimension in ['category', 'occasion', 'style', 'fabric', 'colour'];
      allow delete: if false;
    }
    match /homeSections/{sectionId} {
      allow read: if resource.data.section == 'customStyle';
      allow write: if false;
    }
    match /styleCircleSubscribers/{key} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['email', 'customerId', 'source', 'createdAt'])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() < 320
        && request.resource.data.source == 'style-circle'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    match /customerProfiles/{uid} {
      // Provider subject is not durable Account authority (Section 16 M1 F1).
      // M01 now enforces binding/lifecycle through the trusted Account API.
      // Direct legacy UID reads/writes remain closed; no client flag supplies
      // authority or a fallback around that owner boundary.
      allow read: if false;
      // No dormant UID/email-based Personal Details contract to re-enable.
      // The real durable-Account owner API must implement the locked fields.
      allow write: if false;
    }
    // One private conversation per customer. Messages and summaries commit together.
    match /conversations/{customerId} {
      function owner() {
        return false;
      }
      function participant() {
        return owner() || canStaff('chats.read', 'customer-service', customerId, resource.data.get('assignedStaffId', ''));
      }
      function responder() {
        return canStaff('chats.reply', 'customer-service', customerId, resource.data.get('assignedStaffId', ''));
      }
      function validSummary() {
        let data = request.resource.data;
        let messagePath = /databases/$(database)/documents/conversations/$(customerId)/messages/$(data.lastMessageId);
        let message = getAfter(messagePath).data;
        return data.keys().hasOnly(['customerId', 'customerName', 'customerEmail', 'createdAt', 'lastMessageId', 'lastMessage', 'lastSenderRole', 'updatedAt', 'assignedStaffId'])
          && data.customerId == customerId
          && data.lastMessageId is string
          && !exists(messagePath)
          && data.updatedAt == request.time
          && message.createdAt == request.time
          && message.senderId == request.auth.uid
          && data.lastMessage == message.body
          && data.lastSenderRole == message.senderRole;
      }
      allow get: if participant();
      allow list: if canStaff('chats.read', 'customer-service', customerId, resource.data.get('assignedStaffId', '')) && request.query.limit <= 20;
      allow create: if owner()
        && !request.resource.data.keys().hasAny(['assignedStaffId'])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.customerEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && validSummary();
      allow update: if (owner() || responder())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageId', 'lastMessage', 'lastSenderRole', 'updatedAt'])
        && validSummary();
      allow delete: if false;
      match /messages/{messageId} {
        function staffReplyAudited() {
          let evidence = getAfter(/databases/$(database)/documents/staffAudit/$(messageId)).data;
          return evidence.actorUid == request.auth.uid
            && evidence.actorStaffId == effectiveStaffId()
            && evidence.targetCollection == 'conversations' && evidence.targetId == customerId
            && evidence.action == 'reply' && evidence.createdAt == request.time;
        }
        function messageParticipant() {
          return owner() || canStaff('chats.read', 'customer-service', customerId,
            get(/databases/$(database)/documents/conversations/$(customerId)).data.get('assignedStaffId', ''));
        }
        function validProductContext() {
          let tag = request.resource.data.productContext;
          return tag is map
            && tag.keys().hasAll(['productId', 'name', 'slug', 'imageUrl', 'imagePublicId', 'price', 'variable', 'reviewId'])
            && tag.keys().hasOnly(['productId', 'name', 'slug', 'imageUrl', 'imagePublicId', 'price', 'variable', 'reviewId'])
            && tag.productId is string && tag.productId.size() > 0 && tag.productId.size() <= 200
            && tag.name is string && tag.name.size() > 0 && tag.name.size() <= 240
            && tag.slug is string && tag.slug.size() <= 300
            && tag.imageUrl is string && tag.imageUrl.size() <= 2048
            && (tag.imageUrl == '' || tag.imageUrl.matches('https://.*') || tag.imageUrl.matches('/[^/].*'))
            && tag.imagePublicId is string && tag.imagePublicId.size() <= 512
            && (tag.price == null || (tag.price is number && tag.price >= 0))
            && tag.variable is bool
            && tag.reviewId is string && tag.reviewId.size() <= 200;
        }
        allow get: if messageParticipant();
        allow list: if messageParticipant() && request.query.limit <= 30;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['body', 'senderId', 'senderRole', 'createdAt', 'productContext'])
          && (!request.resource.data.keys().hasAny(['productContext']) || validProductContext())
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000
          && request.resource.data.senderId == request.auth.uid
          && ((request.resource.data.senderRole == 'customer' && owner())
            || (request.resource.data.senderRole == 'admin' && staffReplyAudited() && canStaff('chats.reply', 'customer-service', customerId,
              get(/databases/$(database)/documents/conversations/$(customerId)).data.get('assignedStaffId', ''))))
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/conversations/$(customerId)).data.lastMessageId == messageId
          && getAfter(/databases/$(database)/documents/conversations/$(customerId)).data.updatedAt == request.time;
        allow update, delete: if false;
      }
    }
    match /savedPieces/{uid} {
      allow read, write: if false;
    }
    match /savedReviews/{uid} {
      allow read, write: if false;
    }
  }
}
