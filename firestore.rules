rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin memberships are provisioned by the owner in the Firebase Console.
    // Browser clients, including admins, cannot grant or change memberships.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /products/{productId} {
      function hasPublicProductImage(data) {
        return (data.keys().hasAny(['primaryImage'])
            && ((data.primaryImage is string && data.primaryImage.size() > 0)
              || data.primaryImage is map))
          || (data.keys().hasAny(['images'])
            && data.images is list
            && data.images.size() > 0);
      }
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.status in ['draft', 'published', 'archived']
        && request.resource.data.archived is bool
        && request.resource.data.archived == (request.resource.data.status == 'archived')
        && (request.resource.data.status != 'published'
          || (request.resource.data.price is number
            && request.resource.data.price >= 0
            && request.resource.data.category is list
            && request.resource.data.category.size() > 0
            && hasPublicProductImage(request.resource.data)));
      allow delete: if false;
    }
    match /heroSlides/{slideId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.published is bool
        && request.resource.data.headline is string
        && request.resource.data.headline.size() > 0
        && request.resource.data.concept in ['ready-to-wear', 'aso-oke-fabric', 'custom-style', 'shop-by-occasion', 'bridal-event-dressing'];
      allow delete: if isAdmin();
    }
    match /siteAppearance/{slotId} {
      allow read: if slotId == 'auth' || isAdmin();
      allow create, update: if isAdmin()
        && slotId == 'auth'
        && request.resource.data.eyebrow is string
        && request.resource.data.eyebrow.size() > 0
        && request.resource.data.eyebrow.size() <= 80
        && request.resource.data.headline is string
        && request.resource.data.headline.size() > 0
        && request.resource.data.headline.size() <= 120
        && request.resource.data.supportingText is string
        && request.resource.data.supportingText.size() > 0
        && request.resource.data.supportingText.size() <= 260;
      allow delete: if isAdmin();
    }
    match /discoveryModules/{moduleId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.active is bool
        && request.resource.data.placement in ['home', 'shop']
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 12;
      allow delete: if false;
    }
    match /reviews/{reviewId} {
      allow read: if resource.data.published == true || isAdmin();
      // Customer submission is intentionally not opened here yet: this codebase
      // has no authoritative order/purchase collection against which Firestore
      // can securely prove review eligibility. Admin remains the only writer.
      allow create, update: if isAdmin()
        && request.resource.data.published is bool
        && request.resource.data.status in ['pending', 'published', 'hidden']
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.customerServiceRating is int
        && request.resource.data.customerServiceRating >= 1
        && request.resource.data.customerServiceRating <= 5
        && request.resource.data.productQualityRating is int
        && request.resource.data.productQualityRating >= 1
        && request.resource.data.productQualityRating <= 5
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0;
      allow delete: if isAdmin();
    }
    match /taxonomy/{labelId} {
      // Labels drive the public Shop filters, so every visitor can read
      // them. Writes stay admin-only. Public filters merge these labels
      // with counts from published products, so an admin allocation
      // appears even before a product uses it (with a zero count).
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.dimension in ['category', 'occasion', 'style', 'fabric', 'colour'];
      allow delete: if false;
    }
    match /homeSections/{sectionId} {
      allow read: if resource.data.section == 'customStyle';
      allow write: if false;
    }
    match /styleCircleSubscribers/{key} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['email', 'customerId', 'source', 'createdAt'])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() < 320
        && request.resource.data.source == 'style-circle'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    match /customerProfiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['fullName', 'phoneNumber', 'email', 'createdAt', 'updatedAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber.size() <= 40
        && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }
    // One private conversation per customer. Messages and summaries commit together.
    match /conversations/{customerId} {
      function owner() {
        return request.auth != null && request.auth.uid == customerId;
      }
      function participant() {
        return owner() || isAdmin();
      }
      function validSummary() {
        let data = request.resource.data;
        let messagePath = /databases/$(database)/documents/conversations/$(customerId)/messages/$(data.lastMessageId);
        let message = getAfter(messagePath).data;
        return data.keys().hasOnly(['customerId', 'customerName', 'customerEmail', 'createdAt', 'lastMessageId', 'lastMessage', 'lastSenderRole', 'updatedAt'])
          && data.customerId == customerId
          && data.lastMessageId is string
          && !exists(messagePath)
          && data.updatedAt == request.time
          && message.createdAt == request.time
          && message.senderId == request.auth.uid
          && data.lastMessage == message.body
          && data.lastSenderRole == message.senderRole;
      }
      allow get: if participant();
      allow list: if isAdmin() && request.query.limit <= 20;
      allow create: if owner()
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.customerEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && validSummary();
      allow update: if participant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageId', 'lastMessage', 'lastSenderRole', 'updatedAt'])
        && validSummary();
      allow delete: if false;
      match /messages/{messageId} {
        function validProductContext() {
          let tag = request.resource.data.productContext;
          return tag is map
            && tag.keys().hasAll(['productId', 'name', 'slug', 'imageUrl', 'imagePublicId', 'price', 'variable', 'reviewId'])
            && tag.keys().hasOnly(['productId', 'name', 'slug', 'imageUrl', 'imagePublicId', 'price', 'variable', 'reviewId'])
            && tag.productId is string && tag.productId.size() > 0 && tag.productId.size() <= 200
            && tag.name is string && tag.name.size() > 0 && tag.name.size() <= 240
            && tag.slug is string && tag.slug.size() <= 300
            && tag.imageUrl is string && tag.imageUrl.size() <= 2048
            && (tag.imageUrl == '' || tag.imageUrl.matches('https://.*') || tag.imageUrl.matches('/[^/].*'))
            && tag.imagePublicId is string && tag.imagePublicId.size() <= 512
            && (tag.price == null || (tag.price is number && tag.price >= 0))
            && tag.variable is bool
            && tag.reviewId is string && tag.reviewId.size() <= 200;
        }
        allow get: if participant();
        allow list: if participant() && request.query.limit <= 30;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['body', 'senderId', 'senderRole', 'createdAt', 'productContext'])
          && (!request.resource.data.keys().hasAny(['productContext']) || validProductContext())
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000
          && request.resource.data.senderId == request.auth.uid
          && ((request.resource.data.senderRole == 'customer' && owner())
            || (request.resource.data.senderRole == 'admin' && isAdmin()))
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/conversations/$(customerId)).data.lastMessageId == messageId
          && getAfter(/databases/$(database)/documents/conversations/$(customerId)).data.updatedAt == request.time;
        allow update, delete: if false;
      }
    }
    match /savedPieces/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /savedReviews/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
