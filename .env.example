# Copy this file to .env (and .env.local for personal overrides) and
# fill in real values. Never commit .env or .env.local — see .gitignore.
# All client-exposed Vite variables must be prefixed with VITE_.

# --- Firebase ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Cloudinary ---
# Unsigned upload preset configured in the Cloudinary dashboard.
# Used for client-side image uploads; no API secret is exposed here.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# --- Netlify Functions (server-side only; no VITE_ prefix) ---
# Add server-side secrets here only when a function that needs them
# is actually created (e.g. a signed Cloudinary operation, a payment
# webhook). Configure the real values in the Netlify dashboard under
# Site settings > Environment variables — do not put secrets in this
# repo.

# --- Preview mode ---
# `npm run dev` already shows sample pieces in Home > New In while no
# real pieces exist. To show them in a deployed/preview build too, set
# this to true. Leave it unset on the live storefront.
# VITE_SHOW_SAMPLE_PIECES=true
