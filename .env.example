# Local configuration template. Copy to .env.local and fill in values.
# Never commit .env.local. Variables prefixed VITE_ are public in the browser.

# Firebase web app (same project as Firestore and the Functions)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Netlify Functions can use these locally; set them in Netlify Functions scope too.
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
UDC_IDENTITY_HMAC_KEY=
UDC_SITE_ORIGIN=

# Optional approved proof delivery adapter
UDC_PROOF_DELIVERY_URL=
UDC_PROOF_DELIVERY_KEY=

# Provisioning / maintenance tools (server-side only)
UDC_PROVISION_APPROVAL_SHA256=
UDC_WORKER_KEY=
UDC_WORKER_POLICY_JSON=

# Optional customer session durations; these are client UX settings, not secrets.
VITE_AUTH_STANDARD_SESSION_HOURS=24
VITE_AUTH_EXTENDED_SESSION_DAYS=30
