# Copy this file to .env (and .env.local for personal overrides) and
# fill in real values. Never commit .env or .env.local — see .gitignore.
# All client-exposed Vite variables must be prefixed with VITE_.

# --- Firebase ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Netlify image storage ---
# Set these in Netlify with Functions scope. Use the same Firebase
# project values as above. Locally the function falls back to VITE_*.
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
# No Cloudinary upload preset, Firebase Admin secret or Netlify token required.
# Optional: only for old images saved with Cloudinary public IDs.
VITE_CLOUDINARY_CLOUD_NAME=

# Optional customer-session policy. These are UX/session settings, not secrets.
VITE_AUTH_STANDARD_SESSION_HOURS=24
VITE_AUTH_EXTENDED_SESSION_DAYS=30

# --- Section 16 trusted Account functions (Functions scope ONLY; never VITE_) ---
# Reviewed service account for the same FIREBASE_PROJECT_ID. JSON stays secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Stable per-project secret, at least 32 characters. Rotation needs reviewed migration.
UDC_IDENTITY_HMAC_KEY=
# Exact HTTPS website origin, e.g. https://your-approved-domain.example
UDC_SITE_ORIGIN=
# Approved Section-15 proof-mail adapter; confidential payloads, idempotencyKey honored.
UDC_PROOF_DELIVERY_URL=
UDC_PROOF_DELIVERY_KEY=
# Provisioning CLI only: exact reviewed manifest hash, not a client permission.
UDC_PROVISION_APPROVAL_SHA256=
# M13 operator/worker invocation only; never expose through VITE_ variables.
# Independently generated worker key. Missing key keeps maintenance closed.
UDC_WORKER_KEY=
# Reviewed runtime lease/bounded-attempt policy: leaseMs and maxAttempts.
# No default timing, retry schedule, RPO/RTO or retention policy is invented.
UDC_WORKER_POLICY_JSON=
